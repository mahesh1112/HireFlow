# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Pinecone Vector Database ─────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=hireflow-resumes
PINECONE_ENVIRONMENT=us-east-1

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_USER=hireflow
POSTGRES_PASSWORD=hireflow_password_change_in_production
POSTGRES_DB=hireflow
DATABASE_URL=postgresql+asyncpg://hireflow:hireflow_password@localhost:5432/hireflow
DATABASE_POOL_SIZE=10

# ─── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY_HOURS=168

# ─── Frontend Configuration ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Next-Auth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=debug

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/hireflow_uploads
